# Configuración local de desarrollo para HiLeS.
# No guardar contraseñas en este archivo ni en el repositorio.

listener 1883 0.0.0.0
protocol mqtt
allow_anonymous false
password_file C:\Program Files\mosquitto\passwords.txt

listener 9001 0.0.0.0
protocol websockets
allow_anonymous false
password_file C:\Program Files\mosquitto\passwords.txt

