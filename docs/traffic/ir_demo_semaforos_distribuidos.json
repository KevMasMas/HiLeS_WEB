      "habilitado": true,
      "lenguaje": "python",
      "codigo": "def calcular(**inputs):\n    norte = inputs.get('luz_norte') == 'verde' or inputs.get('luz_norte') == 'amarillo'\n    sur = inputs.get('luz_sur') == 'verde' or inputs.get('luz_sur') == 'amarillo'\n    este = inputs.get('luz_este') == 'verde' or inputs.get('luz_este') == 'amarillo'\n    oeste = inputs.get('luz_oeste') == 'verde' or inputs.get('luz_oeste') == 'amarillo'\n    conflicto = (norte and oeste) or (este and norte) or (este and sur) or (oeste and sur)\n    eje = 'todo-rojo'\n    if conflicto:\n        eje = 'conflicto'\n    elif norte or sur:\n        eje = 'norte-sur'\n    elif este or oeste:\n        eje = 'este-oeste'\n    return {'seguro': not conflicto, 'eje': eje}",
