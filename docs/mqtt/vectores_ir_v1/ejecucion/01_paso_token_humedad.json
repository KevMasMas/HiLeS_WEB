        "transicion": { "habilitada": true, "disparada": true },
        "activo": { "tokens": 1 }
      }
    },
    {
      "entradas": {},
      "elementos_esperados": {
        "sensor": { "valor": 70 },
        "condicion": { "salida": true },
        "espera": { "tokens": 0 },
        "transicion": { "habilitada": true, "disparada": false },
        "activo": { "tokens": 1 }
