          "op": "<",
          "args": [
            { "var": "humedad" },
            { "lit": 76 }
          ]
        }
      },
      {
        "id": "espera",
        "tipo": "place",
        "nombre": "Espera",
        "tokens": 1,
        "capacidad": 1
      },
      {
        "id": "transicion",
        "tipo": "transition",
        "nombre": "Activar riego",
        "habilitada": true,
        "puerto_accion": "transition-action-out"
      },
      {
        "id": "activo",
        "tipo": "place",
        "nombre": "Activo",
        "tokens": 0,
        "capacidad": 1
      }
    ],
    "conexiones": [
