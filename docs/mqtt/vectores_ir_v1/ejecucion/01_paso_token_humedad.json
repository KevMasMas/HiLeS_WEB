        "id": "condicion-transicion",
        "tipo": "dato",
        "origen": "condicion",
        "puerto_origen": "condicion-out",
        "destino": "transicion",
        "puerto_destino": "condicion"
      },
      {
        "id": "espera-transicion",
        "tipo": "arco",
        "origen": "espera",
        "destino": "transicion",
        "peso": 1
      },
      {
        "id": "transicion-activo",
