      "properties": {
        "description": "Compara Norte+Sur contra Este+Oeste y produce automáticamente los cuatro colores.",
        "collapsed": false,
        "locked": false,
        "visible": true,
        "expression": "",
        "executionDelay": 0,
        "enabled": true,
        "tokens": 0,
        "maxTokens": 1,
        "delay": 0,
        "condition": "",
        "heldValue": "",
        "operatorDirection": "right",
        "rotation": 0,
        "codeLanguage": "python",
        "code": "def calcular(**inputs):\n    norte = inputs.get('vehiculos_norte')\n    if norte is None:\n        norte = 0\n    sur = inputs.get('vehiculos_sur')\n    if sur is None:\n        sur = 0\n    este = inputs.get('vehiculos_este')\n    if este is None:\n        este = 0\n    oeste = inputs.get('vehiculos_oeste')\n    if oeste is None:\n        oeste = 0\n    total_norte_sur = norte + sur\n    total_este_oeste = este + oeste\n    luz_norte = 'rojo'\n    luz_sur = 'rojo'\n    luz_este = 'rojo'\n    luz_oeste = 'rojo'\n    eje = 'todo-rojo'\n    if total_norte_sur > total_este_oeste:\n        luz_norte = 'verde'\n        luz_sur = 'verde'\n        eje = 'norte-sur'\n    elif total_este_oeste > total_norte_sur:\n        luz_este = 'verde'\n        luz_oeste = 'verde'\n        eje = 'este-oeste'\n    return {\n        'luz_norte': luz_norte,\n        'luz_sur': luz_sur,\n        'luz_este': luz_este,\n        'luz_oeste': luz_oeste,\n        'eje': eje,\n    }"
      }
    }
