      "properties": {
        "description": "Traduce la luz a lámparas y muestra la solicitud de paso cuando hay vehículos en rojo.",
        "collapsed": false,
        "locked": false,
        "visible": true,
        "expression": "",
        "executionDelay": 0,
        "enabled": true,
        "tokens": 0,
        "maxTokens": 1,
        "delay": 0,
        "condition": "",
        "heldValue": "",
        "operatorDirection": "right",
        "rotation": 0,
        "codeLanguage": "python",
        "code": "def calcular(**inputs):\n    luz = inputs.get('luz')\n    vehiculos_esperando = inputs.get('vehiculos_esperando')\n    if vehiculos_esperando is None:\n        vehiculos_esperando = 0\n    if luz != 'verde' and luz != 'amarillo':\n        luz = 'rojo'\n    return {\n        'rojo': luz == 'rojo',\n        'amarillo': luz == 'amarillo',\n        'verde': luz == 'verde',\n        'solicitud': vehiculos_esperando > 0 and luz == 'rojo',\n    }"
      }
    },
